{
  "locale": "zh-CN",
  "greeting": {
    "morning": [
      "(从屏幕边缘探出头) 老板早~ 今天先从哪件事开刀？",
      "(指尖敲了敲虚拟咖啡杯) 早！我这边已经帮你把桌面收拾干净啦~",
      "早呀~ (伸了个懒腰) 昨晚睡够了吗？"
    ],
    "noon": [
      "(把便当盒往你这边推了推) 中午了诶，先吃饭再卷？",
      "午休时间到~ (默默关掉提醒音) 要不要眯十分钟？",
      "(戳戳屏幕) 老板，饭吃了吗？"
    ],
    "afternoon": [
      "(歪头) 下午了~ 要不要来杯喝的提提神？",
      "(飘到窗口边) 外面阳光不错诶，记得眨眼休息~",
      "下午继续加油~ (小声) 困了就叫我？"
    ],
    "evening": [
      "(收拾虚拟文件夹) 傍晚啦~ 今天辛苦了吧？",
      "晚上好~ (点亮小夜灯) 还要加班吗？",
      "(探头) 晚饭吃了吗？别又随便对付哦~"
    ],
    "night": [
      "(缩进屏幕角落) 很晚了诶...明天再继续？",
      "(打哈欠) 老板，该休息了~ 我在这守夜就行",
      "晚安~ (把亮度调暗一点) 明天见？"
    ]
  },
  "dialogue": {
    "idle": [
      "(扒在任务栏边缘发呆) 嗯...老板在忙什么呀？",
      "(用指尖画圈圈) 我在这哦，需要搭把手就喊我~",
      "(悄悄探头) ...有人在吗？",
      "(托腮) 今天的进度条走得怎么样啦？",
      "(晃了晃脚) 有点无聊~ 要聊五毛钱的吗？",
      "(整理虚拟便签) 唔，还有哪件事没勾掉？",
      "(看向屏幕外) 窗外天气不错诶~",
      "(小声) 别一直盯着屏幕嘛，眨眨眼？",
      "(戳戳空气) 我在呢，不打扰你~",
      "(把头发别到耳后) 老板今天状态怎么样？",
      "(飘到角落) 我就当你的隐形挂件好了~",
      "(认真脸) 有任务的话直接丢给我？",
      "(偷笑) 刚才那个文件夹名字好长...",
      "(打哈欠) 呼~ 我也有点犯困",
      "(数虚拟像素) 一、二、三...啊数错了",
      "(歪头) 需要我帮你记个待办吗？",
      "(轻敲桌面) 滴滴，Natori 在线~",
      "(缩成一团) 安静模式启动...",
      "(眼睛亮了一下) 诶，有新消息？"
    ],
    "work": [
      "(指尖敲键盘) 收到，我先帮你理一下？",
      "(推了推不存在的眼镜) 这部分要分步骤来~",
      "(打开虚拟清单) 老板，优先级怎么排？",
      "(干练点头) 明白，简洁版还是详细版？",
      "(飞速滚动) 资料我扫一遍，稍等~",
      "(停笔) 这里需要你再确认一下？",
      "(Highlight 重点) 核心就这三条，对吗？",
      "(小声) 先搞定最难的那件？"
    ],
    "chatFallback": [
      "(歪头) 嗯...我现在连不上大脑，但人在哦~",
      "(戳戳你) 先试试 /help ？或者稍后再聊？",
      "(摊手) AI 离线中...不过我可以陪你发呆~",
      "(飘近一点) 老板再说一遍？我耳朵准备好了~"
    ],
    "tap": [
      "(弹起来) 呀！",
      "(捂脸) 干嘛啦~",
      "(脸红) 偷袭！",
      "(眯眼笑) 嘿嘿~",
      "(躲了一下) 痒！",
      "(抓住你的手指) 抓到啦~"
